# ============================================================
#  IBM Cloud / Granite Configuration
# ============================================================

# IBM watsonx.ai credentials (IBM Cloud Lite)
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model to use
# Available Granite models confirmed on IBM Cloud Lite (Nov 2026):
#   ibm/granite-3-1-8b-base          ← default (fast, efficient)
#   ibm/granite-4-h-small
#   ibm/granite-embedding-278m-multilingual
#   meta-llama/llama-3-3-70b-instruct (instruct, supports chat tokens)
#   meta-llama/llama-3-1-8b
#   mistralai/mistral-small-3-1-24b-instruct-2503
GRANITE_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ============================================================
#  Research Sources Configuration
# ============================================================

# Semantic Scholar API (free, no key required for basic use)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# CrossRef API (free, polite pool — add your email)
CROSSREF_POLITE_EMAIL=your_email@example.com

# arXiv — no key needed (public API)
ARXIV_MAX_RESULTS=10

# ============================================================
#  Agent Behaviour
# ============================================================

# Max tokens for Granite generation
GRANITE_MAX_TOKENS=1024
GRANITE_TEMPERATURE=0.7
GRANITE_TOP_P=0.95

# Number of papers to retrieve per search query
MAX_PAPERS_PER_QUERY=10

# Output directory for generated reports and citations
OUTPUT_DIR=outputs

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
